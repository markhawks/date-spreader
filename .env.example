# Copia in .env e adatta. Le variabili d'ambiente reali hanno la precedenza sul file .env.

# Nome mostrato nell'interfaccia
APP_NAME=Date Spreader

# Percorso del database SQLite: deve stare su disco LOCALE, mai su una cartella di rete.
DATABASE_PATH=data/datespreader.sqlite3

# Millisecondi di attesa se il database è bloccato da un'altra scrittura
SQLITE_BUSY_TIMEOUT_MS=5000

# Indirizzo e porta del server. 127.0.0.1 = raggiungibile solo da questa macchina.
HOST=127.0.0.1
PORT=8000

# true solo in sviluppo: ricarica il server quando cambia il codice
RELOAD=false

# Accesso: ore di inattività dopo cui la sessione scade
SESSION_HOURS=12

# true solo se il portale è servito in HTTPS (il cookie di sessione viaggia solo cifrato)
COOKIE_SECURE=false

# Licenza AGPL-3.0: indirizzo del codice sorgente mostrato agli utenti (login e «Novità»).
# Se modifichi il portale, punta alla TUA versione. Vuoto = repository ufficiale.
SOURCE_URL=
