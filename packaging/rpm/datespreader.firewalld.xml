<?xml version="1.0" encoding="utf-8"?>
<!-- Date Spreader web portal. Not opened automatically: see docs/INSTALL-RPM.md.
     If you change PORT in /etc/datespreader/datespreader.env, open that port instead.
     NOTE: never put two hyphens in a row inside this comment, it would make the XML invalid
     and firewalld would refuse to start. -->
<service>
  <short>Date Spreader</short>
  <description>Date Spreader web portal (planning of technical interventions), default port 8000/tcp.</description>
  <port protocol="tcp" port="8000"/>
</service>
