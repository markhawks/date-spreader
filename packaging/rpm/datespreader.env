# Date Spreader configuration (RPM package).
# After a change: systemctl restart datespreader

# Name shown in the interface
APP_NAME=Date Spreader

# SQLite database: it must be on a LOCAL disk, never on a network share.
# The backups go in the "backups" folder next to it.
DATABASE_PATH=/var/lib/datespreader/datespreader.sqlite3

# Milliseconds to wait when the database is locked by another write
SQLITE_BUSY_TIMEOUT_MS=5000

# Address and port. 127.0.0.1 = reachable only from this machine;
# 0.0.0.0 = from the network (then open the port: firewall-cmd --permanent --add-service=datespreader).
HOST=127.0.0.1
PORT=8000

# Development only: reload the server when the code changes
RELOAD=false

# Login: hours of inactivity after which the session expires
SESSION_HOURS=12

# true only if the portal is served over HTTPS (the session cookie travels only encrypted)
COOKIE_SECURE=false

# AGPL-3.0 license: address of the source code shown to the users (login page and "What's new").
# If you modify the portal, point it to YOUR version. Empty = official repository.
SOURCE_URL=

# Backups kept by the rotation (daily, weekly, monthly)
#BACKUP_KEEP_DAILY=7
#BACKUP_KEEP_WEEKLY=4
#BACKUP_KEEP_MONTHLY=12
